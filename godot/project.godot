; Bip Island, Godot version (Mac + Windows). See docs/GODOT_MIGRATION.md.
; Shared assets are copied into assets/ by scripts/godot/prepare_assets.py (not committed).

config_version=5

[application]

config/name="Bip Island"
config/description="A learning game for children aged 4 to 8."
config/version="0.2.0"
run/main_scene="res://Scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Bip Island"
config/features=PackedStringArray("4.7", "C#")
boot_splash/bg_color=Color(0.984, 0.957, 0.894, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Boot="*res://Scripts/App/Boot.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/mode=4
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=true

[dotnet]

project/assembly_name="BipIsland"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.984, 0.957, 0.894, 1)
