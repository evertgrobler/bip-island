<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bip Island's game logic: content, phonics, mastery, progress and the round generators.
       No Godot here, so the tests run anywhere with `dotnet test godot/BipCore.Tests`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BipCore</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests can set up a game session in a given state (GameSession.MarkUsed) without reflection. -->
    <InternalsVisibleTo Include="BipCore.Tests" />
  </ItemGroup>
</Project>
